-- ============================================
-- SENSEI HUB — MM2 + BABFT + Blox Fruits + Settings
-- ============================================
local Sensei = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/glitchmode960-gif/library/main/library.lua"
))()

local win = Sensei:CreateWindow({
    Title = "Sensei Hub",
    SubTitle = "MM2 + BABFT + Blox Fruits",
    ScriptFolder = "sensei_hub",
})

-- ============================================
-- ТАБ 1: Main (настройки хаба)
-- ============================================
local mainTab = win:MakeTab({Title = "Main", Icon = "Home"})

mainTab:AddSection("Тема")
mainTab:AddDropdown({
    Name = "Theme",
    Options = Sensei:GetThemes(),
    Default = Sensei:GetTheme().Name,
    Flag = "theme",
    Callback = function(v)
        Sensei:SetTheme(v)
    end,
})

mainTab:AddSection("Масштаб UI")
mainTab:AddSlider({
    Name = "Scale",
    Min = 60, Max = 160, Increment = 5, Default = 85,
    Flag = "ui_scale",
    Callback = function(v)
        Sensei:SetUIScale(v / 100)
    end,
})

mainTab:AddSection("Инфо")
mainTab:AddParagraph("Sensei Hub",
    "Версия: " .. Sensei.Version .. "\n" ..
    "Хаб: MM2 + BABFT + Blox Fruits\n" ..
    "Powered by Wand UI"
)

mainTab:AddButton({
    Name = "Копировать версию",
    Callback = function()
        setclipboard(Sensei.Version)
        win:Notify({Title = "Copied", Content = Sensei.Version, Duration = 2})
    end,
})

mainTab:AddButton({
    Name = "Показать список тем",
    Callback = function()
        local themes = Sensei:GetThemes()
        win:Notify({
            Title = "Themes",
            Content = table.concat(themes, ", "),
            Duration = 5,
        })
    end,
})

mainTab:AddSection("Флаги")
mainTab:AddButton({
    Name = "Сбросить все флаги",
    Callback = function()
        win:DeleteFlags()
        win:Notify({Title = "OK", Content = "Флаги сброшены", Duration = 3})
    end,
})

